# Choose one: openai | anthropic | ollama
LLM_PROVIDER=ollama

# Used if LLM_PROVIDER=openai
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-4o-mini

# Used if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=replace_me
ANTHROPIC_MODEL=claude-sonnet-5

# Used if LLM_PROVIDER=ollama (local, no API key needed)
OLLAMA_MODEL=qwen3:14b
OLLAMA_BASE_URL=http://localhost:11434

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=replace_me
LANGSMITH_PROJECT=langgraph-application-agent
